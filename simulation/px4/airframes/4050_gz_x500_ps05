#!/bin/sh
#
# @name Gazebo x500 PS05 (GPS-denied: tracker external-vision aiding, LiDAR + cameras)
#
# @type Quadrotor
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=ps05_challenge}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_ps05}

param set-default SIM_GZ_EN 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_PX 0.13
param set-default CA_ROTOR0_PY 0.22
param set-default CA_ROTOR0_KM  0.05

param set-default CA_ROTOR1_PX -0.13
param set-default CA_ROTOR1_PY -0.20
param set-default CA_ROTOR1_KM  0.05

param set-default CA_ROTOR2_PX 0.13
param set-default CA_ROTOR2_PY -0.22
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.13
param set-default CA_ROTOR3_PY 0.20
param set-default CA_ROTOR3_KM -0.05

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150

param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000

param set-default MPC_THR_HOVER 0.60
param set-default NAV_DLL_ACT 0

# ---------------------------------------------------------------------------
# BPUT PS05: GPS-DENIED configuration
# The airframe model has NO GNSS sensor, and GPS fusion is disabled in EKF2.
# Position aiding comes from the PS05 ground tracking station (r, theta, phi),
# converted to Cartesian by localization_node and sent as external vision.
# ---------------------------------------------------------------------------
param set-default EKF2_GPS_CTRL 0       # GPS fusion OFF
param set-default EKF2_EV_CTRL 3        # fuse external-vision horizontal + vertical position
param set-default EKF2_HGT_REF 3        # height reference = external vision (tracker)
param set-default EKF2_EV_DELAY 10      # ms, tracker latency (configs/localization.yaml)
param set-default EKF2_EVP_NOISE 0.05   # m, min EV position noise
param set-default EKF2_EV_NOISE_MD 0    # use the variances reported with each measurement
param set-default COM_ARM_WO_GPS 1      # allow arming without GPS
param set-default COM_RCL_EXCEPT 4      # no RC in simulation: ignore RC loss while in offboard
param set-default NAV_RCL_ACT 0
param set-default COM_OBL_RC_ACT 4      # offboard (autonomy) loss -> LAND (PX4-side safe state)
param set-default COM_OF_LOSS_T 1.0
param set-default COM_DISARM_LAND 2
param set-default MPC_LAND_SPEED 0.4
param set-default MPC_XY_VEL_MAX 3.0
param set-default UXRCE_DDS_SYNCT 0     # lockstep SITL: PX4 time == Gazebo sim time == ROS /clock; agent wall-clock timesync would skew EV stamps
